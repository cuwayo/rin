{
  "name": "rin",
  "version": "0.1.0",
  "description": "A decorator-driven WhatsApp command bot built with Zapo and TypeScript.",
  "license": "GPL-3.0-only",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts | pino-pretty",
    "start": "bun src/index.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "verify": "bun run typecheck && bun run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@types/bun": "latest",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@rin-ts/sticker": "^0.2.1",
    "@typesafe-ai/sdk": "^0.7.0",
    "@zapo-js/store-sqlite": "^1.3.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode-terminal": "^0.12.0",
    "zapo-js": "^1.11.0"
  }
}
