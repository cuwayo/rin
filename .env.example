# Command prefix for incoming WhatsApp messages.
BOT_PREFIX=!

# Minimum severity written as structured JSON logs.
BOT_LOG_LEVEL=info

# A stable identifier for this WhatsApp session. Change it to run separate bots.
BOT_SESSION_ID=rin

# Where Zapo persists pairing credentials and Signal state.
BOT_AUTH_PATH=.auth/state.sqlite

# Optional: use WhatsApp's “Link with phone number instead” flow rather than
# a QR code. Enter digits only, including the country code, e.g. 628123456789.
# BOT_PAIRING_PHONE=628123456789

# The one account allowed to manage moderators and use every command. Enter
# only the digits of its WhatsApp number—do not add @s.whatsapp.net or @lid.
# BOT_SUPERUSER_ID=628123456789

# Persistent SQLite store for moderator assignments.
# BOT_ROLE_DB_PATH=.auth/roles.sqlite
